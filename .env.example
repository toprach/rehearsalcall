# Copy to .env beside compose.yaml. It is never committed - see
# .gitignore - and never goes into the image - see .dockerignore.

# Signs the session cookies. REQUIRED: without it the application makes
# up a fresh secret at every start, and every restart signs everybody
# out. Make one with:
#
#   head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'
#
THEATER_GEHEIMNIS=

# The address visitors actually see. Behind a reverse proxy this cannot
# be worked out from the request, and the links handed to the company
# would carry 127.0.0.1 instead.
THEATER_BASIS=https://example.org/theater

# Whom to ask for an access code - shown on the entry page. Leave it
# empty and the page says to ask whoever runs this installation.
THEATER_KONTAKT=

# The key for /theater/admin: create projects, hand out access codes,
# delete projects. Leave it empty and the page does not exist - then
# projects are made with theater-code.mjs. Make one like the secret.
THEATER_ADMIN=

# --- Storage ---------------------------------------------------------
# Leave these empty and the application keeps one JSON file per project
# in the volume. That is the default and needs nothing else.
#
# Set PGUSER and PostgreSQL is used instead. Then you also need the
# driver in the image, which the default build leaves out:
#
#   WITH_POSTGRES=true
#   docker compose --profile postgres up -d --build
#
#WITH_POSTGRES=true
#PGUSER=theater
#PGPASSWORD=
#PGDATABASE=theater
#PGHOST=postgres
