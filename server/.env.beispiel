# Vorlage. Die echte Datei heisst .env, liegt neben app.js und ist
# chmod 600. Sie gehoert NICHT ins Verzeichnis.

# Speicher: ohne PGUSER werden Dateien verwendet - dann laeuft die
# Anwendung ohne jede Einrichtung, auch oertlich zum Entwickeln.
# THEATER_DATEN gibt das Verzeichnis an (Vorgabe: ~/theater-daten).
#THEATER_DATEN=/pfad/zu/theater-daten

# Mit diesen vier Angaben wird stattdessen PostgreSQL genommen.
#PGHOST=127.0.0.1
#PGUSER=benutzer
#PGPASSWORD=kennwort
#PGDATABASE=datenbank

# Adresse, unter der die Seite erreichbar ist. Hinter einem Proxy noetig,
# sonst stehen in den Links 127.0.0.1.
THEATER_BASIS=https://beispiel.tv

# Wen die Einstiegsseite fuer einen Zugangscode nennt. Ohne Eintrag
# steht dort ein neutraler Satz.
#THEATER_KONTAKT=regie@beispiel.tv

# Schluessel fuer /theater/admin (Projekte anlegen, Codes vergeben,
# loeschen). Ohne Eintrag gibt es die Seite nicht.
#THEATER_ADMIN=

# Unterschreibt die Sitzungs-Kekse. Ohne diesen Eintrag wird bei jedem
# Start neu gewuerfelt - dann ist nach jedem Neustart jeder abgemeldet.
#   head -c 32 /dev/urandom | od -An -tx1 | tr -d ' 
'
THEATER_GEHEIMNIS=
